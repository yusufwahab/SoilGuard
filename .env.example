# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real secrets.

# --- Supabase (replaces Firebase) ------------------------------------
# Project Settings -> API in your Supabase dashboard. Run supabase/schema.sql
# in the SQL editor once before using this. Anon key is safe for the
# browser -- it's the public key, access is governed by RLS policies.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- WhatsApp Alerts (via CallMeBot) ---------------------------------
# 1. Save +34 644 59 71 67 as a contact in your phone.
# 2. From YOUR WhatsApp, message that contact: "I allow callmebot to send me messages"
# 3. It replies with your personal API key -- paste it below.
# 4. VITE_WHATSAPP_PHONE is YOUR number in international format, no "+", no spaces.
VITE_WHATSAPP_PHONE=2348000000000
VITE_WHATSAPP_APIKEY=
