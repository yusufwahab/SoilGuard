# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real secrets.

# --- Supabase (replaces Firebase) ------------------------------------
# Project Settings -> API in your Supabase dashboard. Run supabase/schema.sql
# in the SQL editor once before using this. Anon key is safe for the
# browser -- it's the public key, access is governed by RLS policies.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Backend (see backend/) -------------------------------------------
# Where the alert (Telegram) + AI analysis backend is running. Local by
# default; point this at your Render URL once deployed.
VITE_BACKEND_URL=http://localhost:8787

# Alert credentials (TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID) live in
# backend/.env, not here -- see backend/README.md for setup.

# --- Weather widget (via OpenWeatherMap) -------------------------------
# Free tier: openweathermap.org -> sign up -> API keys tab -> copy the
# default key. New keys can take up to ~2 hours to activate -- if you get
# 401 errors right after signing up, that's normal, just wait a bit.
# Note: this key ends up embedded in the built frontend JS (anyone can see
# it via browser devtools) since it's used client-side for the widget --
# common practice for this kind of key, but not something I've verified is
# officially endorsed by OpenWeatherMap, so keep an eye on usage if that
# matters to you.
VITE_OPENWEATHER_API_KEY=
