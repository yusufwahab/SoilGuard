# Copy to .env and fill in. .env is gitignored (covered by the root
# .gitignore's pathless .env pattern) -- never commit real secrets.

PORT=8787

# --- Supabase (server-side) ------------------------------------------
# Same project as the frontend's VITE_SUPABASE_URL, but this uses the
# SERVICE ROLE key (Project Settings -> API), not the anon key -- it
# bypasses RLS and must NEVER be exposed to a browser. Only lives here.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers -- tried in this order: Gemini -> Groq -> Claude ----
# Only Gemini is required to start; Groq/Claude are used only if Gemini
# fails, so leaving them blank just skips that fallback step.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Weather (via Open-Meteo -- free, no API key needed) ---------------
# The farm's location normally comes from Supabase's farm_settings table --
# the farmer types a place name in the app's Settings page (Fields &
# Devices tab), which gets geocoded client-side and saved there. These two
# vars are ONLY a fallback for before that's been set (or for local dev
# without touching Settings); leave blank to skip weather context entirely
# until a location is set (analysis still runs fine on sensor data alone).
FARM_LATITUDE=
FARM_LONGITUDE=

# --- Schedule -----------------------------------------------------------
# How often the analysis job runs, in minutes. Matches the existing UI
# copy ("n8n will push the next analysis in 30-60 minutes").
ANALYSIS_INTERVAL_MINUTES=30

# How many minutes of recent sensor_readings to feed into each analysis.
ANALYSIS_LOOKBACK_MINUTES=60

# --- Alerts (via Telegram Bot API -- free, official, no per-message cost) -
# See backend/README.md for the full setup walkthrough.
# 1. Message @BotFather on Telegram, send /newbot, follow the prompts.
# 2. Message your new bot anything first (Telegram requires this before
#    a bot can message you back).
# 3. Visit https://api.telegram.org/bot<token>/getUpdates in a browser to
#    find your numeric chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
